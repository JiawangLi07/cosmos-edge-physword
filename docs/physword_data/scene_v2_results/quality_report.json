    ],
    "definitions": {
      "approach": "Move the hand toward a visible object before enclosure or manipulation.",
      "move": "Translate the hand or its held object through free space; do not imply release.",
      "pick": "Acquire and lift an object from its support as a complete pickup action.",
      "place": "Set an object on a support and visibly release it.",
      "flip": "Turn an object over to its opposite face.",
      "rotate": "Change the orientation of a held object through wrist or finger rotation.",
      "toggle": "Change a visible switch between discrete positions.",
      "open": "Open a visible articulated object or container.",
      "close": "Close a visible articulated object or container.",
      "push": "Drive a visible object away by sustained hand contact.",
      "pull": "Draw a visible object toward the hand by contact.",
      "insert": "Feed the shuttlecock tip/body into the tube aperture, inferred from observable relative entry across time.",
      "press": "Depress a visible object or control by contact; not a generic label for occluded fingers.",
      "click": "Actuate a visible button or clicking control.",
      "strike": "Hit a visible object with a brief impact.",
      "handover": "Transfer a visible object between hands or agents.",
      "rest": "An empty hand maintains its resting/ready pose without manipulating an object; a valid posture phase.",
      "hold": "Maintain a continuous grasp and approximately stable support of an already acquired object, including the tube held for the other hand.",
      "grasp": "Close or conform fingers around a visible object; the phase can end before a successful lift, which must not be presumed.",
      "lift": "Raise an enclosed object away from the table/support, with visible upward object motion.",
      "align": "Reposition/orient hand, object or aperture to establish relative alignment; does not assert successful contact or insertion.",
      "adjust": "Visible fine finger, grip or object repositioning around an existing manipulation site; no unseen press or successful insertion is implied.",
      "retract": "Withdraw the hand from the manipulation site without carrying the manipulated object.",
      "lower": "Move the held object downward toward the table; does not assert support contact or release.",
      "release": "Open fingers and separate them from a previously grasped object, using the temporal sequence to verify continued object support elsewhere."
    }
  },
